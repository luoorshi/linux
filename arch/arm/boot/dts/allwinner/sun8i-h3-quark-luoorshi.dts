#include "sun8i-h3-nanopi.dtsi"
#include <dt-bindings/thermal/thermal.h>

/ {
	model = "Quark-N Lois H3";
	compatible = "Lois,Quark-N-h3", "allwinner,sun8i-h3";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
        serial2 = &uart2;
        serial3 = &uart3;
		spi0 = &spi0;
		spi1 = &spi1;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
        i2c2 = &i2c2;
		mmc0 = &mmc0;
        mmc2 = &mmc2;
		i2s0 = &i2s0;
		pcm5102a = &pcm5102a;
	};

	chosen {
		/* 居中显示 1 个企鹅；若 boot.scr 覆盖 bootargs，请同步加上 */
		bootargs = "console=ttyS0,115200 root=/dev/mmcblk0p2 rootwait panic=10 fbcon=logo-count:1,logo-pos:center";
	};
	pcm5102a: pcm5102a-codec {
        #sound-dai-cells = <0>;
        compatible = "ti,pcm5102a";
        status = "disabled";
    };

    sound_i2s {
        compatible = "simple-audio-card";
        simple-audio-card,name = "I2S-master";
        simple-audio-card,mclk-fs = <256>;
        simple-audio-card,format = "i2s";
        status = "disabled";

        simple-audio-card,cpu {
            sound-dai = <&i2s0>;
        };

        simple-audio-card,codec {
            sound-dai = <&pcm5102a>;
        };
    };

	/*
	 * CPU 电压固定 1.1V（PL8 只有一档）。
	 * H3 公共 OPP 里 1008MHz 标称 1.2V，这里按 quark-n 策略改成 1.1V。
	 */
	reg_vdd_cpux: vdd_cpux {
		compatible = "regulator-gpio";
		regulator-name = "vdd_cpux";
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		gpios = <&r_pio 0 8 GPIO_ACTIVE_HIGH>; /* PL8 */
		states = <1100000 0x1>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&ehci0 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

/* USB Host，和 H5 / quark-n 参考板一样打开 usb1，供 RTL8723BU 等 USB 设备枚举 */
&ehci1 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&usb_otg {
	status = "okay";
	dr_mode = "peripheral";
};

&usbphy {
	/* Type-A 口 VBUS 常开，和 H5 板一致 */
	usb0_id_det-gpios = <&pio 6 12 GPIO_ACTIVE_HIGH>; /* PG12 */
	status = "okay";
};

/* add for Lois */
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pa_pins>;
	status = "okay";
};

&mmc0 {
    pinctrl-names = "default";
    linux,phandle = <0x20>;
    pinctrl-0 = <&mmc0_pins>;
    cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 */
    vmmc-supply = <&reg_vcc3v3>;
    bus-width = <4>;
    boot_device = <0>;
    removable = <1>;
    // cd-inverted;
    cap-sd-highspeed;
    mmc-driver-type = <0>;
    status = "okay";
};

&mmc2 {
    linux,phandle = <0x10>;
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_8bit_pins>;
	vmmc-supply = <&reg_vcc3v3>;
    clock-frequency = <52000000>;
	bus-width = <8>;
    mmc-driver-type = <1>;
	non-removable;
	cap-mmc-hw-reset;
	boot_device = <0>;
	status = "okay";
};

&spi0 {
	status = "okay";
	u-boot,dm-pre-reloc;
	bootph-all;
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pins>;
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * IPS 1.14" 240x135 ST7789VW — same as linux_card:
	 * fb_st7789vw + fbtft_device ips_114inch_240_135
	 * PA0=DC, PA1=RESET; driver hardcodes MADCTL 0x70 / offset 40,53
	 *
	 * sitronix,st7789v kept for U-Boot; kernel binds sitronix,st7789vw.
	 */
	display@0 {
		compatible = "sitronix,st7789vw", "sitronix,st7789v";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <32000000>;
		buswidth = <8>;
		/* rotate=0: FB stays 240x135; MADCTL rotation is in fb_st7789vw */
		rotate = <0>;
		fps = <33>;
		/* PA1=UART2_RX (reset), PA0=UART2_TX (dc); avoid PA4/PA5 (UART0) */
		reset-gpios = <&pio 0 1 GPIO_ACTIVE_LOW>;
		dc-gpios = <&pio 0 0 GPIO_ACTIVE_HIGH>;
		debug = <0>;

		/* U-Boot-only (kernel fbtft ignores these) */
		col-offset = <53>;
		row-offset = <40>;
		rotation = <90>;

		u-boot,dm-pre-reloc;
		bootph-all;
	};
};

/*
 * MPU6050 on TWI0: PA11=SCL, PA12=SDA. AD0 low -> address 0x68.
 * sunxi-h3-h5.dtsi 里的 i2c0_pins 只有 function = "i2c0"，没有上拉。
 * TWI 是开漏，没有上拉时 SDA/SCL 拉不高，mv64xxx 会报
 * "I2C bus locked"，probe 返回 -ETIMEDOUT(-110)。
 * 与 quark-n 一致：100kHz + PA11/PA12 内部上拉。
 */
&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	clock-frequency = <100000>;
	status = "okay";

	mpu6050@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
		status = "okay";
		vdd-supply = <&reg_vcc3v3>;
		vddio-supply = <&reg_vcc3v3>;
	};
};

&i2c0_pins {
	bias-pull-up;
};


&codec {
    compatible = "allwinner,sun8i-h3-codec";
    #sound-dai-cells = <0>;
    allwinner,audio-routing =
        "Line Out", "LINEOUT",
        "MIC1", "Mic",
        "Mic",  "MBIAS";
    status = "okay";
};

&codec_analog {
    status = "okay";
};

/*
 * H3 只使用 sun8i-h3.dtsi 里的三档：648 / 816 / 1008 MHz。
 * 电压改成固定 1.1V，和 reg_vdd_cpux 一致。
 * cooling state 0 是最高频率：
 *   0:1008  1:816  2:648 MHz
 */
&cpu0_opp_table {
	opp-648000000 {
		opp-microvolt = <1100000>;
	};

	opp-816000000 {
		opp-microvolt = <1100000>;
	};

	opp-1008000000 {
		opp-microvolt = <1100000>;
	};
};

&cpu0 {
	cpu-supply = <&reg_vdd_cpux>;
};

&cpu1 {
	cpu-supply = <&reg_vdd_cpux>;
};

&cpu2 {
	cpu-supply = <&reg_vdd_cpux>;
};

&cpu3 {
	cpu-supply = <&reg_vdd_cpux>;
};

&cpu_thermal {
	polling-delay = <1000>;
	polling-delay-passive = <200>;
	/* H3 ths 的 #thermal-sensor-cells = <0>，这里不能带 sensor id */
	thermal-sensors = <&ths>;

	/* 去掉公共 dtsi 的 80°C passive / 100°C critical，只保留这套降频策略 */
	/delete-node/ trips;
	/delete-node/ cooling-maps;

	trips {
		cpu_warm: cpu_warm {
			temperature = <55000>;
			hysteresis = <5000>;
			type = "passive";
		};
		cpu_hot: cpu_hot {
			temperature = <62000>;
			hysteresis = <5000>;
			type = "passive";
		};
		cpu_very_hot: cpu_very_hot {
			temperature = <70000>;
			hysteresis = <5000>;
			type = "passive";
		};
		cpu_extreme: cpu_extreme {
			temperature = <76000>;
			hysteresis = <5000>;
			type = "passive";
		};
		cpu_crit: cpu_crit {
			temperature = <80000>;
			hysteresis = <0>;
			type = "critical";
		};
	};

	cooling-maps {
		/* state >= 1：最高 816MHz */
		cpu_warm_limit_cpu {
			trip = <&cpu_warm>;
			cooling-device = <&cpu0 1 THERMAL_NO_LIMIT>,
					 <&cpu1 1 THERMAL_NO_LIMIT>,
					 <&cpu2 1 THERMAL_NO_LIMIT>,
					 <&cpu3 1 THERMAL_NO_LIMIT>;
		};
		/* state >= 2：锁在 648MHz。H3 最低档就是 648MHz */
		cpu_hot_limit_cpu {
			trip = <&cpu_hot>;
			cooling-device = <&cpu0 2 THERMAL_NO_LIMIT>,
					 <&cpu1 2 THERMAL_NO_LIMIT>,
					 <&cpu2 2 THERMAL_NO_LIMIT>,
					 <&cpu3 2 THERMAL_NO_LIMIT>;
		};
		cpu_very_hot_limit_cpu {
			trip = <&cpu_very_hot>;
			cooling-device = <&cpu0 2 THERMAL_NO_LIMIT>,
					 <&cpu1 2 THERMAL_NO_LIMIT>,
					 <&cpu2 2 THERMAL_NO_LIMIT>,
					 <&cpu3 2 THERMAL_NO_LIMIT>;
		};
		cpu_extreme_limit_cpu {
			trip = <&cpu_extreme>;
			cooling-device = <&cpu0 2 THERMAL_NO_LIMIT>,
					 <&cpu1 2 THERMAL_NO_LIMIT>,
					 <&cpu2 2 THERMAL_NO_LIMIT>,
					 <&cpu3 2 THERMAL_NO_LIMIT>;
		};
	};
};

