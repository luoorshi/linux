/dts-v1/;
#include "sun50i-h5.dtsi"
#include "sun50i-h5-cpu-opp.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/sun4i-a10.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	model = "Quark-N Lois H5";
	compatible = "Lois,Quark-N-h5", "allwinner,sun50i-h5";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
        serial2 = &uart2;
        serial3 = &uart3;
		spi0 = &spi0;
		spi1 = &spi1;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
        i2c2 = &i2c2;
		mmc0 = &mmc0;
        mmc2 = &mmc2;
		i2s0 = &i2s0;
		pcm5102a = &pcm5102a;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/*
		 * 240x135 小屏：只画 1 个企鹅，并居中。
		 * 若 /boot.scr 覆盖了 bootargs，请在脚本里同样加上：
		 *   fbcon=logo-count:1 fbcon=logo-pos:center
		 * （或合并写：fbcon=logo-count:1,logo-pos:center —— 取决于脚本拼接方式；
		 *  推荐两个 fbcon= 参数或一个里用空格分隔的 options，见下。）
		 */
		bootargs = "console=ttyS0,115200 root=/dev/mmcblk0p2 rootwait panic=10 fbcon=logo-count:1,logo-pos:center";
	};

	reg_vcc3v3: vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "orangepi:green:pwr";
			gpios = <&r_pio 0 10 GPIO_ACTIVE_HIGH>; /* PA10 */
			default-state = "on";
		};

		led-1 {
			label = "orangepi:red:status";
			gpios = <&pio 0 17 GPIO_ACTIVE_HIGH>; /* PA17 */
		};
	};

	reg_gmac_3v3: gmac-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "gmac-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <100000>;
		enable-active-high;
		gpio = <&pio 3 6 GPIO_ACTIVE_HIGH>; /* PD6 */
	};
	pcm5102a: pcm5102a-codec {
        #sound-dai-cells = <0>;
        compatible = "ti,pcm5102a";
        status = "disabled";
    };

    sound_i2s {
        compatible = "simple-audio-card";
        simple-audio-card,name = "I2S-master";
        simple-audio-card,mclk-fs = <256>;
        simple-audio-card,format = "i2s";
        status = "disabled";

        simple-audio-card,cpu {
            sound-dai = <&i2s0>;
        };

        simple-audio-card,codec {
            sound-dai = <&pcm5102a>;
        };
    };

	/*
	 * CPU 电压固定 1.1V（PL8 只有一档）。
	 * 高于 1008MHz 的 OPP 需要 1.24V 以上，在 opp 表里关掉。
	 */
	reg_vdd_cpux: vdd_cpux {
		compatible = "regulator-gpio";
		regulator-name = "vdd_cpux";
		regulator-min-microvolt = <1100000>;
		regulator-max-microvolt = <1100000>;
		gpios = <&r_pio 0 8 GPIO_ACTIVE_HIGH>; /* PL8 */
		states = <1100000 0x1>;
		regulator-always-on;
		regulator-boot-on;
	};
};

&ehci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&external_mdio {
	ext_rgmii_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
	};
};

&ohci0 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pa_pins>;
	status = "okay";
};

&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	/* USB Type-A ports' VBUS is always on */
	usb0_id_det-gpios = <&pio 6 12 GPIO_ACTIVE_HIGH>; /* PG12 */
	status = "okay";
};

/* SD card — missing previously caused: Waiting for root device /dev/mmcblk0p2 */
&mmc0 {
    pinctrl-names = "default";
    linux,phandle = <0x20>;
    pinctrl-0 = <&mmc0_pins>;
    cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 */
    vmmc-supply = <&reg_vcc3v3>;
    bus-width = <4>;
    boot_device = <0>;
    removable = <1>;
    // cd-inverted;
    cap-sd-highspeed;
    mmc-driver-type = <0>;
    status = "okay";
};

&mmc2 {
    linux,phandle = <0x10>;
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_8bit_pins>;
	vmmc-supply = <&reg_vcc3v3>;
    clock-frequency = <52000000>;
	bus-width = <8>;
    mmc-driver-type = <1>;
	non-removable;
	cap-mmc-hw-reset;
	boot_device = <0>;
	status = "okay";
};

/* add for Lois */
&spi0 {
	status = "okay";
	u-boot,dm-pre-reloc;
	bootph-all;
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pins>;
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * IPS 1.14" 240x135 ST7789VW — same as linux_card:
	 * fb_st7789vw, MADCTL 0x70, offset 40/53, no BGR
	 */
	display@0 {
		compatible = "sitronix,st7789vw", "sitronix,st7789v";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <32000000>;
		buswidth = <8>;
		rotate = <0>;
		fps = <33>;
		reset-gpios = <&pio 0 1 GPIO_ACTIVE_LOW>;
		dc-gpios = <&pio 0 0 GPIO_ACTIVE_HIGH>;
		debug = <0>;

		/* U-Boot-only */
		col-offset = <53>;
		row-offset = <40>;
		rotation = <90>;

		u-boot,dm-pre-reloc;
		bootph-all;
	};
};

/* MPU6050 on TWI0: PA11=SCL, PA12=SDA. AD0 low -> address 0x68. */
&i2c0 {
	status = "okay";
    #size-cells = <0>;
    #address-cells = <1>;
	clock-frequency = <100000>;
	mpu6050@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
		vdd-supply = <&reg_vcc3v3>;
		vddio-supply = <&reg_vcc3v3>;
	};
};

&i2s0 {
    sound-dai = <&pcm5102a>;
    status = "disabled";
};


&codec {
    compatible = "allwinner,sun8i-h3-codec";
    #sound-dai-cells = <0>;
    allwinner,audio-routing =
        "Line Out", "LINEOUT",
        "MIC1", "Mic",
        "Mic",  "MBIAS";
    status = "okay";
};

&codec_analog {
    status = "okay";
};

/*
 * 覆盖 sun50i-h5-cpu-opp.dtsi。
 * 使能的 6 档全部锁在 1.1V，和固定电压调节器一致。
 * cpufreq cooling state 0 是最高频率，数字越大频率越低：
 *   0:1008  1:960  2:912  3:816  4:648  5:408 MHz
 * 1056/1104/1152MHz 需要更高电压，保持 disabled。
 */
&cpu_opp_table {
	compatible = "operating-points-v2";
	opp-shared;

	opp-408000000 {
		opp-hz = /bits/ 64 <408000000>;
		opp-microvolt = <1100000>;
		clock-latency-ns = <244144>; /* 8 32k periods */
	};

	opp-648000000 {
		opp-hz = /bits/ 64 <648000000>;
		opp-microvolt = <1100000>;
		clock-latency-ns = <244144>; /* 8 32k periods */
	};

	opp-816000000 {
		opp-hz = /bits/ 64 <816000000>;
		opp-microvolt = <1100000>;
		clock-latency-ns = <244144>; /* 8 32k periods */
	};

	opp-912000000 {
		opp-hz = /bits/ 64 <912000000>;
		opp-microvolt = <1100000>;
		clock-latency-ns = <244144>; /* 8 32k periods */
	};

	opp-960000000 {
		opp-hz = /bits/ 64 <960000000>;
		opp-microvolt = <1100000>;
		clock-latency-ns = <244144>; /* 8 32k periods */
	};

	opp-1008000000 {
		opp-hz = /bits/ 64 <1008000000>;
		opp-microvolt = <1100000>;
		clock-latency-ns = <244144>; /* 8 32k periods */
	};

	opp-1056000000 {
		status = "disabled";
		opp-hz = /bits/ 64 <1056000000>;
		opp-microvolt = <1240000 1240000 1310000>;
		clock-latency-ns = <244144>; /* 8 32k periods */
	};

	opp-1104000000 {
		status = "disabled";
		opp-hz = /bits/ 64 <1104000000>;
		opp-microvolt = <1260000 1260000 1310000>;
		clock-latency-ns = <244144>; /* 8 32k periods */
	};

	opp-1152000000 {
		status = "disabled";
		opp-hz = /bits/ 64 <1152000000>;
		opp-microvolt = <1300000 1300000 1310000>;
		clock-latency-ns = <244144>; /* 8 32k periods */
	};
};

&cpu0 {
	clock-names = "cpu";
	clocks = <&ccu CLK_CPUX>;
	cpu-supply = <&reg_vdd_cpux>;
	operating-points-v2 = <&cpu_opp_table>;
};

&cpu1 {
	clock-names = "cpu";
	clocks = <&ccu CLK_CPUX>;
	cpu-supply = <&reg_vdd_cpux>;
	operating-points-v2 = <&cpu_opp_table>;
};

&cpu2 {
	clock-names = "cpu";
	clocks = <&ccu CLK_CPUX>;
	cpu-supply = <&reg_vdd_cpux>;
	operating-points-v2 = <&cpu_opp_table>;
};

&cpu3 {
	clock-names = "cpu";
	clocks = <&ccu CLK_CPUX>;
	cpu-supply = <&reg_vdd_cpux>;
	operating-points-v2 = <&cpu_opp_table>;
};

&cpu_thermal {
	polling-delay = <1000>;
	polling-delay-passive = <200>;
	thermal-sensors = <&ths 0>;

	/* 去掉公共 dtsi 的 80°C passive / 100°C critical，只保留这套降频策略 */
	/delete-node/ trips;
	/delete-node/ cooling-maps;

	trips {
		cpu_warm: cpu_warm {
			temperature = <55000>;
			hysteresis = <5000>;
			type = "passive";
		};
		cpu_hot: cpu_hot {
			temperature = <62000>;
			hysteresis = <5000>;
			type = "passive";
		};
		cpu_very_hot: cpu_very_hot {
			temperature = <70000>;
			hysteresis = <5000>;
			type = "passive";
		};
		cpu_extreme: cpu_extreme {
			temperature = <76000>;
			hysteresis = <5000>;
			type = "passive";
		};
		cpu_crit: cpu_crit {
			temperature = <80000>;
			hysteresis = <0>;
			type = "critical";
		};
	};

	cooling-maps {
		/* state >= 3：最高 816MHz */
		cpu_warm_limit_cpu {
			trip = <&cpu_warm>;
			cooling-device = <&cpu0 3 THERMAL_NO_LIMIT>,
					 <&cpu1 3 THERMAL_NO_LIMIT>,
					 <&cpu2 3 THERMAL_NO_LIMIT>,
					 <&cpu3 3 THERMAL_NO_LIMIT>;
		};
		/* state >= 4：最高 648MHz */
		cpu_hot_limit_cpu {
			trip = <&cpu_hot>;
			cooling-device = <&cpu0 4 THERMAL_NO_LIMIT>,
					 <&cpu1 4 THERMAL_NO_LIMIT>,
					 <&cpu2 4 THERMAL_NO_LIMIT>,
					 <&cpu3 4 THERMAL_NO_LIMIT>;
		};
		/* state >= 5：锁在 408MHz */
		cpu_very_hot_limit_cpu {
			trip = <&cpu_very_hot>;
			cooling-device = <&cpu0 5 THERMAL_NO_LIMIT>,
					 <&cpu1 5 THERMAL_NO_LIMIT>,
					 <&cpu2 5 THERMAL_NO_LIMIT>,
					 <&cpu3 5 THERMAL_NO_LIMIT>;
		};
		cpu_extreme_limit_cpu {
			trip = <&cpu_extreme>;
			cooling-device = <&cpu0 5 THERMAL_NO_LIMIT>,
					 <&cpu1 5 THERMAL_NO_LIMIT>,
					 <&cpu2 5 THERMAL_NO_LIMIT>,
					 <&cpu3 5 THERMAL_NO_LIMIT>;
		};
	};
};

