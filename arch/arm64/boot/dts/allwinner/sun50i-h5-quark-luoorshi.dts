/dts-v1/;
#include "sun50i-h5.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/sun4i-a10.h>

/ {
	model = "Quark-N Lois H5";
	compatible = "Lois,Quark-N-h5", "allwinner,sun50i-h5";

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
        serial2 = &uart2;
        serial3 = &uart3;
		spi0 = &spi0;
		spi1 = &spi1;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
        i2c2 = &i2c2;
		mmc0 = &mmc0;
        mmc2 = &mmc2;
		i2s0 = &i2s0;
		pcm5102a = &pcm5102a;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/*
		 * 240x135 小屏：只画 1 个企鹅，并居中。
		 * 若 /boot.scr 覆盖了 bootargs，请在脚本里同样加上：
		 *   fbcon=logo-count:1 fbcon=logo-pos:center
		 * （或合并写：fbcon=logo-count:1,logo-pos:center —— 取决于脚本拼接方式；
		 *  推荐两个 fbcon= 参数或一个里用空格分隔的 options，见下。）
		 */
		bootargs = "console=ttyS0,115200 root=/dev/mmcblk0p2 rootwait panic=10 fbcon=logo-count:1,logo-pos:center";
	};

	reg_vcc3v3: vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "orangepi:green:pwr";
			gpios = <&r_pio 0 10 GPIO_ACTIVE_HIGH>; /* PA10 */
			default-state = "on";
		};

		led-1 {
			label = "orangepi:red:status";
			gpios = <&pio 0 17 GPIO_ACTIVE_HIGH>; /* PA17 */
		};
	};

	reg_gmac_3v3: gmac-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "gmac-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <100000>;
		enable-active-high;
		gpio = <&pio 3 6 GPIO_ACTIVE_HIGH>; /* PD6 */
	};
	pcm5102a: pcm5102a-codec {
        #sound-dai-cells = <0>;
        compatible = "ti,pcm5102a";
        status = "disabled";
    };

    sound_i2s {
        compatible = "simple-audio-card";
        simple-audio-card,name = "I2S-master";
        simple-audio-card,mclk-fs = <256>;
        simple-audio-card,format = "i2s";
        status = "disabled";

        simple-audio-card,cpu {
            sound-dai = <&i2s0>;
        };

        simple-audio-card,codec {
            sound-dai = <&pcm5102a>;
        };
    };
};

&ehci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&external_mdio {
	ext_rgmii_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
	};
};

&ohci0 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pa_pins>;
	status = "okay";
};

&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

&usbphy {
	/* USB Type-A ports' VBUS is always on */
	usb0_id_det-gpios = <&pio 6 12 GPIO_ACTIVE_HIGH>; /* PG12 */
	status = "okay";
};

/* SD card — missing previously caused: Waiting for root device /dev/mmcblk0p2 */
&mmc0 {
    pinctrl-names = "default";
    linux,phandle = <0x20>;
    pinctrl-0 = <&mmc0_pins>;
    cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 */
    vmmc-supply = <&reg_vcc3v3>;
    bus-width = <4>;
    boot_device = <0>;
    removable = <1>;
    // cd-inverted;
    cap-sd-highspeed;
    mmc-driver-type = <0>;
    status = "okay";
};

&mmc2 {
    linux,phandle = <0x10>;
	pinctrl-names = "default";
	pinctrl-0 = <&mmc2_8bit_pins>;
	vmmc-supply = <&reg_vcc3v3>;
    clock-frequency = <52000000>;
	bus-width = <8>;
    mmc-driver-type = <1>;
	non-removable;
	cap-mmc-hw-reset;
	boot_device = <0>;
	status = "okay";
};

/* add for Lois */
&spi0 {
	status = "okay";
	u-boot,dm-pre-reloc;
	bootph-all;
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_pins>;
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * IPS 1.14" 240x135 ST7789VW — same as linux_card:
	 * fb_st7789vw, MADCTL 0x70, offset 40/53, no BGR
	 */
	display@0 {
		compatible = "sitronix,st7789vw", "sitronix,st7789v";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <32000000>;
		buswidth = <8>;
		rotate = <0>;
		fps = <33>;
		reset-gpios = <&pio 0 1 GPIO_ACTIVE_LOW>;
		dc-gpios = <&pio 0 0 GPIO_ACTIVE_HIGH>;
		debug = <0>;

		/* U-Boot-only */
		col-offset = <53>;
		row-offset = <40>;
		rotation = <90>;

		u-boot,dm-pre-reloc;
		bootph-all;
	};
};

/* MPU6050 on TWI0: PA11=SCL, PA12=SDA. AD0 low -> address 0x68. */
&i2c0 {
	status = "okay";
    #size-cells = <0>;
    #address-cells = <1>;
	clock-frequency = <100000>;
	mpu6050@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
		vdd-supply = <&reg_vcc3v3>;
		vddio-supply = <&reg_vcc3v3>;
	};
};

&i2s0 {
    sound-dai = <&pcm5102a>;
    status = "disabled";
};


&codec {
    compatible = "allwinner,sun8i-h3-codec";
    #sound-dai-cells = <0>;
    allwinner,audio-routing =
        "Line Out", "LINEOUT",
        "MIC1", "Mic",
        "Mic",  "MBIAS";
    status = "okay";
};

&codec_analog {
    status = "okay";
};

